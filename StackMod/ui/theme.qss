/* OBS Studio Dark Theme Stylesheet */

QWidget {
    background-color: #1e1f29;
    color: #e0e0e0;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 10pt;
    selection-background-color: #2b78e4;
    selection-color: #ffffff;
}

QMainWindow {
    background-color: #16171f;
}

/* Menu Bar */
QMenuBar {
    background-color: #1e1f29;
    color: #cccccc;
    border-bottom: 1px solid #2d2f3d;
    padding: 2px 6px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #2d2f3d;
    color: #ffffff;
}

QMenu {
    background-color: #242633;
    color: #e0e0e0;
    border: 1px solid #36384a;
    padding: 4px;
    border-radius: 6px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #2b78e4;
    color: #ffffff;
}

/* ToolBar & Status Bar */
QStatusBar {
    background-color: #16171f;
    color: #9da5b4;
    border-top: 1px solid #2d2f3d;
    font-size: 9pt;
}

/* Dock Widgets */
QDockWidget {
    color: #e0e0e0;
    font-weight: bold;
    titlebar-close-icon: url(none);
    titlebar-normal-icon: url(none);
}

QDockWidget::title {
    background-color: #242633;
    padding: 6px 10px;
    border: 1px solid #2d2f3d;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    text-align: left;
}

/* Push Buttons */
QPushButton {
    background-color: #2d3040;
    color: #ffffff;
    border: 1px solid #3b3f54;
    padding: 6px 14px;
    border-radius: 5px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #383c50;
    border-color: #4b506b;
}

QPushButton:pressed {
    background-color: #232533;
}

QPushButton:disabled {
    background-color: #1e1f29;
    color: #555869;
    border-color: #282a38;
}

/* Primary Action Buttons */
QPushButton#btn_primary {
    background-color: #2b78e4;
    border-color: #3b88f4;
    font-weight: bold;
}

QPushButton#btn_primary:hover {
    background-color: #3b88f4;
}

QPushButton#btn_primary:pressed {
    background-color: #1f5eb6;
}

/* Danger / Stop Buttons */
QPushButton#btn_danger {
    background-color: #d9383a;
    border-color: #e54d4f;
    font-weight: bold;
}

QPushButton#btn_danger:hover {
    background-color: #e54d4f;
}

QPushButton#btn_danger:pressed {
    background-color: #b32628;
}

/* Success / Record Buttons */
QPushButton#btn_success {
    background-color: #2ea043;
    border-color: #3fb950;
    font-weight: bold;
}

QPushButton#btn_success:hover {
    background-color: #3fb950;
}

/* Sliders */
QSlider::groove:horizontal {
    border: 1px solid #36384a;
    height: 6px;
    background: #242633;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #2b78e4;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 1px solid #2b78e4;
    width: 14px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #e0e8ff;
}

/* List Widgets */
QListWidget {
    background-color: #181922;
    border: 1px solid #2d2f3d;
    border-radius: 6px;
    padding: 4px;
}

QListWidget::item {
    padding: 6px 10px;
    border-radius: 4px;
}

QListWidget::item:selected {
    background-color: #2b78e4;
    color: #ffffff;
}

QListWidget::item:hover:!selected {
    background-color: #242633;
}

/* Checkboxes & Radio Buttons */
QCheckBox, QRadioButton {
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: #242633;
    border: 1px solid #3b3f54;
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #2b78e4;
    border-color: #2b78e4;
}

/* Line Edit & Combo Box */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #181922;
    border: 1px solid #36384a;
    border-radius: 5px;
    padding: 5px 8px;
    color: #ffffff;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #2b78e4;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #2d2f3d;
    background-color: #1e1f29;
}

QTabBar::tab {
    background-color: #242633;
    color: #a0a0a0;
    padding: 6px 14px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #1e1f29;
    color: #ffffff;
    font-weight: bold;
}

/* Scroll Bars */
QScrollBar:vertical {
    background: #181922;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #36384a;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #4b506b;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
