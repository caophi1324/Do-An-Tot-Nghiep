<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Scene lighting (Tắt cast_shadows để tăng FPS cực mạnh trên WSLg) -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 0.22 0.25 1</ambient>
            <diffuse>0.3 0.33 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- DRONE 1: Red -->
    <model name="drone1">
      <static>true</static>
      <pose>0.0 0.0 0.05 0 0 0</pose>
      <link name="base_link">
        <visual name="mesh_visual">
          <geometry>
            <mesh>
              <uri>model://kamikaze_drone/kamikaze_drone_ros.dae</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
        <visual name="led_indicator">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry>
            <sphere><radius>0.04</radius></sphere>
          </geometry>
          <material>
            <ambient>1 0.1 0.1 1</ambient>
            <diffuse>1 0.1 0.1 1</diffuse>
            <emissive>1 0.1 0.1 1</emissive>
          </material>
        </visual>
      </link>
    </model>
    <!-- DRONE 2: Green -->
    <model name="drone2">
      <static>true</static>
      <pose>0.0 1.6 0.05 0 0 0</pose>
      <link name="base_link">
        <visual name="mesh_visual">
          <geometry>
            <mesh>
              <uri>model://kamikaze_drone/kamikaze_drone_ros.dae</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
        <visual name="led_indicator">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry>
            <sphere><radius>0.04</radius></sphere>
          </geometry>
          <material>
            <ambient>0.1 0.95 0.2 1</ambient>
            <diffuse>0.1 0.95 0.2 1</diffuse>
            <emissive>0.1 0.95 0.2 1</emissive>
          </material>
        </visual>
      </link>
    </model>
    <!-- DRONE 3: Blue -->
    <model name="drone3">
      <static>true</static>
      <pose>0.0 3.2 0.05 0 0 0</pose>
      <link name="base_link">
        <visual name="mesh_visual">
          <geometry>
            <mesh>
              <uri>model://kamikaze_drone/kamikaze_drone_ros.dae</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
        <visual name="led_indicator">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry>
            <sphere><radius>0.04</radius></sphere>
          </geometry>
          <material>
            <ambient>0.15 0.5 1 1</ambient>
            <diffuse>0.15 0.5 1 1</diffuse>
            <emissive>0.15 0.5 1 1</emissive>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
